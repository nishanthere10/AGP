# response.gbnf — LocalAgentBench response contract for configs B and C.
# Enforces a single JSON object with exactly one key "fix" whose value is the
# corrected Python function body (any characters, JSON-escaped).
root ::= ws? "{" ws fix-kv ws "}" ws
fix-kv ::= fix-key ws ":" ws fix-val
fix-key ::= "\"fix\""
fix-val ::= "\"" chars "\""
chars ::= char*
char ::= ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))
ws ::= [ \t\n\r]*
